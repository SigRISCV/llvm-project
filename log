+// Generate external fixup sections for external symbol references
+// These sections allow the linker to fix up external PointToID values during static linking
+void RISCVCollectGlobalPointers::generateExtFixupSections(Module &M, const DataLayout &DL) {
+  if (ExtFixupMap.empty() && ExtGOTMap.empty()) {
+    LLVM_DEBUG(dbgs() << "No external references, skipping ext fixup sections\n");
+    return;
+  }
+
+  LLVMContext &Ctx = M.getContext();
+  unsigned PtrSize = DL.getPointerSize();
+  IntegerType *PtrSizedIntTy = Type::getIntNTy(Ctx, PtrSize * 8);
+  IntegerType *I8Ty = Type::getInt8Ty(Ctx);
+  IntegerType *I32Ty = Type::getInt32Ty(Ctx);
+
+  // ========== Generate External GOT Section ==========
+  // Format: { addr(64), id(64), sym_index(64), offset(64) } = 32 bytes
+  // For each external symbol in ExtGOTMap
+  if (!ExtGOTMap.empty()) {
+    // Struct type for ext GOT entry: { ptr, id, sym_index, offset }
+    StructType *ExtGOTEntryTy = StructType::get(Ctx, {
+        PtrSizedIntTy,  // addr
+        PtrSizedIntTy,  // id
+        PtrSizedIntTy,  // sym_index (placeholder, linker will fill)
+        PtrSizedIntTy   // offset (for relocation)
+    });
+    
+    SmallVector<Constant *, 32> ExtGOTEntries;
+    uint32_t SymIdx = 0;
+    
+    for (auto &KV : ExtGOTMap) {
+      const GlobalValue *GV = KV.first;
+      const ExtGOTEntry &Entry = KV.second;
+      
+      // Get the address of the external symbol (will be relocated)
+      Constant *Addr = ConstantExpr::getPtrToInt(
+          const_cast<GlobalValue *>(GV), PtrSizedIntTy);
+      Constant *ID = ConstantInt::get(PtrSizedIntTy, Entry.PointToID);
+      Constant *SymIndex = ConstantInt::get(PtrSizedIntTy, SymIdx++);
+      Constant *Offset = ConstantInt::get(PtrSizedIntTy, 0);  // Linker will fill
+      
+      ExtGOTEntries.push_back(ConstantStruct::get(ExtGOTEntryTy, 
+          {Addr, ID, SymIndex, Offset}));
+    }
+    
+    ArrayType *ExtGOTArrayTy = ArrayType::get(ExtGOTEntryTy, ExtGOTEntries.size());
+    Constant *ExtGOTInit = ConstantArray::get(ExtGOTArrayTy, ExtGOTEntries);
+    GlobalVariable *ExtGOTGV = new GlobalVariable(
+        M, ExtGOTArrayTy, false, GlobalValue::PrivateLinkage, ExtGOTInit, "");
+    ExtGOTGV->setSection(SectionExtGOT);
+    ExtGOTGV->setAlignment(Align(PtrSize));
+    
+    // Count for ext GOT
+    GlobalVariable *ExtGOTCountGV = new GlobalVariable(M, I32Ty, true, 
+        GlobalValue::PrivateLinkage,
+        ConstantInt::get(I32Ty, ExtGOTEntries.size()), "");
+    ExtGOTCountGV->setSection(SectionCounter);
+    
+    LLVM_DEBUG(dbgs() << "Generated external GOT with " << ExtGOTEntries.size() 
+                      << " entries\n");
+  }
+
+  // ========== Generate External Fixup Sections ==========
+  // Header format: { ext_id(64), sym_index(64), data_offset(64) }
+  // Data format: { section_type(8), offset(64) }[] for each location
+  if (!ExtFixupMap.empty()) {
+    StructType *FixupHeaderTy = StructType::get(Ctx, {
+        PtrSizedIntTy,  // ext_id
+        PtrSizedIntTy,  // sym_index
+        PtrSizedIntTy   // data_offset
+    });
+    
+    // Each data entry: section_type(8) + offset(64) = 9 bytes
+    // But for alignment, we use a struct of {i8, i64}
+    StructType *FixupDataEntryTy = StructType::get(Ctx, {I8Ty, PtrSizedIntTy});
+    
+    SmallVector<Constant *, 32> FixupHeaders;
+    SmallVector<Constant *, 128> FixupDataEntries;
+    
+    uint64_t DataOffset = 0;
+    const uint64_t DataEntrySize = 1 + PtrSize;  // section_type(1) + offset(8)
+    
+    // Build sym_index mapping from ExtGOTMap
+    DenseMap<uint32_t, uint32_t> ExtIDToSymIdx;
+    uint32_t SymIdx = 0;
+    for (auto &KV : ExtGOTMap) {
+      ExtIDToSymIdx[KV.second.PointToID] = SymIdx++;
+    }
+    
+    for (auto &KV : ExtFixupMap) {
+      uint32_t ExtID = KV.first;
+      const ExtFixupInfo &Info = KV.second;
+      
+      // Find sym_index for this ExtID
+      uint32_t SymIndex = ExtIDToSymIdx.count(ExtID) ? ExtIDToSymIdx[ExtID] : 0;
+      
+      // Create header entry
+      Constant *Header = ConstantStruct::get(FixupHeaderTy, {
+          ConstantInt::get(PtrSizedIntTy, ExtID),
+          ConstantInt::get(PtrSizedIntTy, SymIndex),
+          ConstantInt::get(PtrSizedIntTy, DataOffset)
+      });
+      FixupHeaders.push_back(Header);
+      
+      // Create data entries for all locations
+      for (const ExtFixupLocation &Loc : Info.Locations) {
+        Constant *DataEntry = ConstantStruct::get(FixupDataEntryTy, {
+            ConstantInt::get(I8Ty, static_cast<uint8_t>(Loc.SectionType)),
+            ConstantInt::get(PtrSizedIntTy, Loc.Offset)
+        });
+        FixupDataEntries.push_back(DataEntry);
+        DataOffset += DataEntrySize;
+      }
+    }
+    
+    // Generate fixup header section
+    if (!FixupHeaders.empty()) {
+      ArrayType *HeaderArrayTy = ArrayType::get(FixupHeaderTy, FixupHeaders.size());
+      Constant *HeaderInit = ConstantArray::get(HeaderArrayTy, FixupHeaders);
+      GlobalVariable *HeaderGV = new GlobalVariable(
+          M, HeaderArrayTy, true, GlobalValue::PrivateLinkage, HeaderInit, "");
+      HeaderGV->setSection(SectionExtFixupHeader);
+      HeaderGV->setAlignment(Align(PtrSize));
+      
+      // Count for fixup headers
+      GlobalVariable *FixupCountGV = new GlobalVariable(M, I32Ty, true, 
+          GlobalValue::PrivateLinkage,
+          ConstantInt::get(I32Ty, FixupHeaders.size()), "");
+      FixupCountGV->setSection(SectionCounter);
+    }
+    
+    // Generate fixup data section
+    if (!FixupDataEntries.empty()) {
+      ArrayType *DataArrayTy = ArrayType::get(FixupDataEntryTy, FixupDataEntries.size());
+      Constant *DataInit = ConstantArray::get(DataArrayTy, FixupDataEntries);
+      GlobalVariable *DataGV = new GlobalVariable(
+          M, DataArrayTy, true, GlobalValue::PrivateLinkage, DataInit, "");
+      DataGV->setSection(SectionExtFixupData);
+      DataGV->setAlignment(Align(PtrSize));
+    }
+    
+    LLVM_DEBUG(dbgs() << "Generated external fixup tables:\n"
+                      << "  Fixup Headers: " << FixupHeaders.size() << "\n"
+                      << "  Fixup Data Entries: " << FixupDataEntries.size() << "\n");
+  }
 }
 
